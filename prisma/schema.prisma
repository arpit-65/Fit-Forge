generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model College {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  leagues   League[]
  squads    Squad[]
  users     User[]

  @@map("colleges")
}

model User {
  id                String                 @id @default(cuid())
  authId            String?                @unique
  email             String                 @unique
  name              String
  rollNo            String?                @unique
  department        String?
  year              Int?
  avatarUrl         String?
  collegeId         String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  activities        Activity[]
  badges            Badge[]
  challenges        ChallengeParticipant[]
  interventions     Intervention[]
  leagueMemberships LeagueMember[]
  pointsLedger      PointsLedger[]
  riskScores        RiskScore[]
  squadMemberships  SquadMember[]
  streak            Streak?
  college           College?               @relation(fields: [collegeId], references: [id])

  @@index([name])
  @@index([collegeId])
  @@map("users")
}

model Squad {
  id          String           @id @default(cuid())
  name        String
  description String?
  avatarUrl   String?
  collegeId   String?
  maxSize     Int              @default(10)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  challenges  SquadChallenge[]
  members     SquadMember[]
  college     College?         @relation(fields: [collegeId], references: [id])

  @@map("squads")
}

model SquadMember {
  userId   String
  squadId  String
  role     String   @default("member")
  joinedAt DateTime @default(now())
  squad    Squad    @relation(fields: [squadId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, squadId])
  @@unique([squadId, userId])
  @@map("squad_members")
}

model Activity {
  id              String   @id @default(cuid())
  userId          String
  type            String
  durationMinutes Int
  date            DateTime @default(now())
  notes           String?
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([date])
  @@map("activities")
}

model Challenge {
  id                    String                 @id @default(cuid())
  title                 String
  description           String
  targetMinutes         Int
  originalTargetMinutes Int?
  status                ChallengeStatus        @default(ACTIVE)
  dueDate               DateTime
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  participants          ChallengeParticipant[]
  squads                SquadChallenge[]

  @@map("challenges")
}

model ChallengeParticipant {
  userId        String
  challengeId   String
  minutesLogged Int             @default(0)
  status        ChallengeStatus @default(ACTIVE)
  completed     Boolean         @default(false)
  joinedAt      DateTime        @default(now())
  challenge     Challenge       @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, challengeId])
  @@index([challengeId])
  @@map("challenge_participants")
}

model SquadChallenge {
  squadId     String
  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  squad       Squad     @relation(fields: [squadId], references: [id], onDelete: Cascade)

  @@id([squadId, challengeId])
  @@map("squad_challenges")
}

model RiskScore {
  id              String   @id @default(cuid())
  userId          String
  score           Float
  band            RiskBand
  topReason       String
  bootstrapActive Boolean  @default(false)
  computedAt      DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, computedAt])
  @@index([computedAt])
  @@index([band])
  @@index([band, computedAt])
  @@map("risk_scores")
}

model Intervention {
  id         String           @id @default(cuid())
  userId     String
  type       InterventionType
  message    String
  firedAt    DateTime         @default(now())
  resolvedAt DateTime?
  createdAt  DateTime         @default(now())
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, firedAt])
  @@index([resolvedAt])
  @@index([type])
  @@index([type, firedAt])
  @@map("interventions")
}

model PointsLedger {
  id        String   @id @default(cuid())
  userId    String
  points    Int
  reason    String
  date      DateTime @default(now())
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("points_ledger")
}

model Streak {
  id             String   @id @default(cuid())
  userId         String   @unique
  currentStreak  Int      @default(0)
  longestStreak  Int      @default(0)
  lastActiveDate DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, lastActiveDate])
  @@map("streaks")
}

model Badge {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String
  icon        String
  earnedAt    DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, earnedAt])
  @@map("badges")
}

model League {
  id        String         @id @default(cuid())
  collegeId String
  name      String
  tier      String
  season    String
  startDate DateTime
  endDate   DateTime
  createdAt DateTime       @default(now())
  members   LeagueMember[]
  college   College        @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@map("leagues")
}

model LeagueMember {
  id       String   @id @default(cuid())
  leagueId String
  userId   String
  points   Int      @default(0)
  rank     Int?
  joinedAt DateTime @default(now())
  league   League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([leagueId, userId])
  @@index([userId, joinedAt])
  @@map("league_members")
}

enum RiskBand {
  LOW
  MID
  HIGH
}

enum InterventionType {
  NUDGE
  SQUAD_NUDGE
  GOAL_DOWNGRADE
  MENTOR_CHECKIN
}

enum ChallengeStatus {
  ACTIVE
  COMPLETED
  DOWNGRADED
  EXPIRED
}
