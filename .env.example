# FitForge Environment Variables Template
# ──────────────────────────────────────────────────────────────────
# Database Connection (Supabase / Neon PostgreSQL)
# Pooled connection on port 6543 with pgbouncer=true for runtime queries
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Direct connection on port 5432 for Prisma CLI migrations
DIRECT_URL="postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres"

# Supabase Auth & Storage API keys
# Obtain from Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://[ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"
# Server-only: used for backend admin tasks; never send to the browser
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# Cron & API Protection Secret (Bearer token for cron / internal triggers)
CRON_SECRET="your-cron-secret-token"
RISK_RECOMPUTE_SECRET="your-cron-secret-token"

# App Deployment URLs
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Gemini AI (Server-side only — never sent to browser; optional with template fallback)
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-1.5-flash"
